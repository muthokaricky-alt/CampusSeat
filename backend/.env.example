# Copy to .env and edit. Never commit the real .env file.
# development | test | production. Production enforces the stricter checks in src/config.js.
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Public address of the site (links in emails, CSRF origin check). Required in production.
APP_URL=http://localhost:4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=campusseat
DB_PASSWORD=change_me
DB_NAME=campusseat_db
# Set to true when using a hosted MySQL that requires SSL (Aiven, TiDB Cloud, ...)
DB_SSL=false
# Optional: the server CA certificate (PEM, 
 for newlines) to verify the TLS connection. Aiven: Overview > CA certificate.
DB_SSL_CA=
# Login sessions (server-side, httpOnly cookie). COOKIE_SECURE defaults to true in production
# and must stay true there; set it to true locally only when serving over HTTPS.
COOKIE_SECURE=false
# Log out after this many minutes without activity, and after this many days in any case.
SESSION_IDLE_MINUTES=120
SESSION_MAX_DAYS=7
# Frontend dev server origin (CORS). Not needed when the built frontend is served by this server.
CLIENT_ORIGIN=http://localhost:5173
# Encrypts administrators' two-factor secrets in the database. Required in production.
# 32 random bytes as base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe and stable: changing it disables everyone's existing two-factor setup.
TOTP_ENC_KEY=
# Outgoing email (password reset links, waitlist news).
#   console = print emails in this terminal (development only, refused in production)
#   smtp    = any SMTP server      resend = Resend HTTP API (use on hosts that block SMTP, e.g. Render free tier)
MAIL_DRIVER=console
MAIL_FROM="CampusSeat <no-reply@example.com>"
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# RESEND_API_KEY=
# Reset links expire after this many minutes.
RESET_TOKEN_MINUTES=30
# Lock an account for LOCKOUT_MINUTES (doubling on repeats) after LOCKOUT_THRESHOLD failed logins.
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
# Used only by "npm run seed"
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEMO_PASSWORD=Student@12345
