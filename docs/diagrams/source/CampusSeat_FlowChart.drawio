<mxfile host="app.diagrams.net"><diagram name="Booking and check-in flow" id="campusseat-flow"><mxGraphModel dx="1000" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fontSize=13;fillColor=#e6edf7;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="250" y="20" width="100" height="44" as="geometry"/></mxCell><mxCell id="login" value="Log in with email and password (then a 6-digit code if two-factor is on)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="180" y="100" width="240" height="64" as="geometry"/></mxCell><mxCell id="d1" value="Details correct?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="190" y="204" width="220" height="96" as="geometry"/></mxCell><mxCell id="e1" value="One general error message; 5 failures lock the account for a while" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#f8e3e3;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="220" width="210" height="64" as="geometry"/></mxCell><mxCell id="browse" value="Browse events: search, filter by type, This week, Saved" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="180" y="340" width="240" height="60" as="geometry"/></mxCell><mxCell id="select" value="Open an event and select Reserve my seat (details come from the account)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="180" y="440" width="240" height="64" as="geometry"/></mxCell><mxCell id="tx" value="Begin transaction: lock the event row" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#e8f3e4;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="180" y="544" width="240" height="50" as="geometry"/></mxCell><mxCell id="d2" value="Event already ended?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="190" y="630" width="220" height="96" as="geometry"/></mxCell><mxCell id="e2" value="Roll back: &quot;this event has already taken place&quot;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#f8e3e3;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="646" width="210" height="64" as="geometry"/></mxCell><mxCell id="d3" value="Already booked it?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="190" y="760" width="220" height="96" as="geometry"/></mxCell><mxCell id="e3" value="Roll back: &quot;you have already booked a seat for this event&quot;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#f8e3e3;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="776" width="210" height="64" as="geometry"/></mxCell><mxCell id="d4" value="Open to your school?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="190" y="890" width="220" height="96" as="geometry"/></mxCell><mxCell id="e4" value="Roll back: &quot;this event is open to ... only&quot;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#f8e3e3;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="906" width="210" height="64" as="geometry"/></mxCell><mxCell id="d5" value="Seat left?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="190" y="1020" width="220" height="96" as="geometry"/></mxCell><mxCell id="e5" value="Roll back: &quot;this event is full&quot;, offer Join the waitlist" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#f8e3e3;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="1036" width="210" height="64" as="geometry"/></mxCell><mxCell id="save" value="Save the booking with a unique reference and commit; audit BOOK_SEAT" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#e8f3e4;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="180" y="1150" width="240" height="64" as="geometry"/></mxCell><mxCell id="card" value="Show the registration card with its QR code (kept on the phone for offline use)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="180" y="1250" width="240" height="64" as="geometry"/></mxCell><mxCell id="door" value="At the door: staff scan the QR code or type the reference" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="180" y="1350" width="240" height="60" as="geometry"/></mxCell><mxCell id="d6" value="Right event, check-in open, card not used yet?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="190" y="1446" width="220" height="110" as="geometry"/></mxCell><mxCell id="e6" value="Amber or red result with the reason; nothing is recorded" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#f8e3e3;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="1468" width="210" height="64" as="geometry"/></mxCell><mxCell id="in" value="Checked in: green result; audit CHECK_IN" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#e8f3e4;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="180" y="1600" width="240" height="56" as="geometry"/></mxCell><m